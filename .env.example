# =========================================================================
# Seynex Enterprises Sales Management Suite - Environment Configuration
# =========================================================================

# 1. Primary Supabase Database
VITE_SUPABASE_URL=https://your-primary-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_primary_supabase_anon_public_key

# 2. Dedicated Database for Seynex Enterprises (Optional override)
VITE_SUPABASE_URL_SEYNEX=https://seynex-project.supabase.co
VITE_SUPABASE_ANON_KEY_SEYNEX=your_seynex_supabase_anon_public_key

# 3. Server-Side Communications Gateway Credentials (QuickSend SMS)
QUICKSEND_API_USER=your_quicksend_username_or_email
QUICKSEND_API_KEY=your_quicksend_api_key

# 5. Optional Error Tracking & Performance Monitoring
SENTRY_DSN=https://your-sentry-dsn.ingest.sentry.io/project-id
