# GymSales Pro Enterprise Environment Configuration Template
# Copy this file to .env for local development or configure in Vercel / Production Dashboard

# 1. Supabase PostgreSQL Database & Auth API
VITE_SUPABASE_URL=https://your-supabase-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_public_key

# 2. Server-Side Communications Gateway Credentials (NEVER ship to browser)
QUICKSEND_API_USER=your_quicksend_username_or_email
QUICKSEND_API_KEY=your_quicksend_api_key

# 3. Optional Error Tracking & Uptime Monitoring (e.g. Sentry)
SENTRY_DSN=https://your-sentry-dsn.ingest.sentry.io/project-id
